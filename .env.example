# Database — use Neon/Supabase/Vercel Postgres (SQLite will not work on Vercel)
# Example: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_..."   # from Stripe Dashboard webhook (production) or `stripe listen` (local)

# App
APP_URL="http://localhost:3000"
ORG_NAME="Your Charity Name"

# Auth (magic-link sign-in for staff)
SESSION_SECRET=""                    # long random string, e.g. `openssl rand -hex 32`
ALLOWED_EMAILS=""                    # comma-separated allowlist, e.g. "a@org.org,b@org.org"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="donations@yourcharity.org"

# SMS (Twilio) - optional, only needed for the Text action
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
